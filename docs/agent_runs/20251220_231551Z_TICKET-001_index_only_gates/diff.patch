         feeds = metrics.get("feeds") or metrics.get("table") or []
         if isinstance(feeds, list):
             summary["feeds"] = [dict(entry) for entry in feeds if isinstance(entry, dict)]
-    return summary
+    return _apply_scope_to_summary(summary, scope)
