import re
from pathlib import Path
root = Path("docs/agent_runs/20251222_030117Z_TICKET-008_aws_dry_run_deploy_verify")
patterns = [
    (re.compile(r"https?://\d{12}\.signin\.aws\.amazon\.com/console"), "<REDACTED_AWS_SIGNIN_URL>"),
    (re.compile(r"\b\d{12}\b"), "<REDACTED_AWS_ACCOUNT>"),
    (re.compile(r"(?i)(username)\s*[:=]\s*\S+"), r"\1: <REDACTED>"),
    (re.compile(r"(?i)(password)\s*[:=]\s*\S+"), r"\1: <REDACTED>"),
    (re.compile(r"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}"), "<REDACTED_EMAIL>"),
]
redacted_files = []
for path in root.rglob("*"):
    if not path.is_file():
        continue
    text = path.read_text()
    new_text = text
    for pattern, repl in patterns:
        new_text = pattern.sub(repl, new_text)
    if new_text != text:
        path.write_text(new_text)
        redacted_files.append(str(path))
print("Redacted files:")
for p in redacted_files:
    print(f"- {p}")
PY
