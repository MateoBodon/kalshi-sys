from pathlib import Path
import re
root = Path("docs/agent_runs/20251222_030117Z_TICKET-008_aws_dry_run_deploy_verify")
replacements = [
    (re.compile(r"kalshi-admin"), "<REDACTED_USER>"),
    (re.compile(r"signin\.aws\.amazon\.com"), "<REDACTED_AWS_SIGNIN_HOST>"),
]
redacted = []
for path in root.rglob("*"):
    if not path.is_file():
        continue
    text = path.read_text()
    new = text
    for pattern, repl in replacements:
        new = pattern.sub(repl, new)
    if new != text:
        path.write_text(new)
        redacted.append(str(path))
print("Redacted files:")
for p in redacted:
    print(f"- {p}")
PY
