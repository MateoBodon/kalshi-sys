+    staging_root = tmp_path / "docs" / "gpt_bundles" / run_name
+    with pytest.raises(BundleBuildError) as excinfo:
+        stage_bundle(tmp_path, run_name, staging_root)
+    assert "reports/other/OMIT.md" in str(excinfo.value)
