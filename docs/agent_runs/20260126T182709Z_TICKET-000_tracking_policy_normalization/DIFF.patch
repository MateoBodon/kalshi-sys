++++    _write_text(root / "project_state" / "KNOWN_ISSUES.md", "issues\n")
++++    _write_text(root / "project_state" / "CONFIG_REFERENCE.md", "config\n")
++++
++++
++++def _write_zip_from_staging(zip_path: Path, staging_root: Path, workspace_root: Path) -> None:
