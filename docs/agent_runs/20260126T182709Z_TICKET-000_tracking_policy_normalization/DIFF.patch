++++            entry = entry[:-1]
++++        if entry:
++++            paths.append(entry)
++++    seen: set[str] = set()
++++    unique: list[str] = []
++++    for item in paths:
++++        if item not in seen:
++++            seen.add(item)
++++            unique.append(item)
++++    return unique
