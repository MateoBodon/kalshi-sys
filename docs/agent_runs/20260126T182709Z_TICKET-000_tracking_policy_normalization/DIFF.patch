++++def _copy_tree(
++++    src_dir: Path, dest_dir: Path, staging_root: Path, staged_files: set[str]
++++) -> None:
++++    if not src_dir.exists():
++++        return
++++    for path in src_dir.rglob("*"):
++++        if path.is_file():
++++            rel = path.relative_to(src_dir)
++++            dest = dest_dir / rel
++++            _copy_file(path, dest, staging_root, staged_files)
