++++def _latest_curve_path(root: Path) -> Path | None:
++++    if not root.exists():
++++        return None
++++    candidates: list[tuple[date, Path]] = []
++++    fallbacks: list[tuple[float, Path]] = []
++++    for path in root.glob(_CURVE_GLOB):
++++        if not path.is_file():
