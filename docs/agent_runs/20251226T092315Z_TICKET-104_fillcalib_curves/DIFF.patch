+++def build_fillcalib_dataset(
+++    *,
+++    series: str,
+++    date_from: date,
+++    date_to: date,
+++    telemetry_root: Path,
+++    horizon_seconds: int = DEFAULT_HORIZON_SECONDS,
+++    min_samples: int = DEFAULT_MIN_SAMPLES,
+++    scaler: float = DEFAULT_SCALER,
