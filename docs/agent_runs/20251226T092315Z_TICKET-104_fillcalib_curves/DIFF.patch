+++            "series": intent.series,
+++            "window_id": window_id,
+++            "market_ticker": intent.market_ticker,
+++            "side": side,
+++            "quote_price": intent.price,
+++            "quote_size": intent.size,
+++            "quote_ts": intent.ts.isoformat(),
