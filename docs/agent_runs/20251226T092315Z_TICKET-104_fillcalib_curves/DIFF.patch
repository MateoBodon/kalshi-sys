+++++        if asof is not None:
+++++            candidates.append((asof, path))
+++++        else:
+++++            try:
+++++                fallbacks.append((path.stat().st_mtime, path))
+++++            except OSError:
+++++                continue
+++++    if candidates:
+++++        return max(candidates, key=lambda item: item[0])[1]
+++++    if fallbacks:
+++++        return max(fallbacks, key=lambda item: item[0])[1]
+++++    return None
