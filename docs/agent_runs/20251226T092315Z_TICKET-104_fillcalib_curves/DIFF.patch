+++                QuoteIntent(
+++                    ts=ts,
+++                    series=series,
+++                    window_id=window_id,
+++                    window_ts_utc=window_ts_utc,
+++                    market_ticker=ticker,
+++                    side=side,
+++                    price=float(price),
+++                    size=size,
