+++            {
+++                "proxy_fill_rate": round(proxy_rate, 6),
+++                "p_fill": round(p_fill, 6),
+++                "min_samples": min_samples,
+++                "scaler": round(scaler, 6),
+++                "cap": round(max_fill, 6),
+++                "reason": reason,
