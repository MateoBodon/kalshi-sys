git status --short
# Output: untracked reports/* only

git cherry-pick codex/TICKET-000_ignore-reports
# Output: cherry-picked ignore-reports commit onto main

git stash pop
# Output: restored AGENTS.md + docs/DOCS_AND_LOGGING_SYSTEM.md changes

git status --short
# Output: AGENTS.md and docs/DOCS_AND_LOGGING_SYSTEM.md modified

rg -n "2025-12-23" docs/PROGRESS.md
# Output: location of 2025-12-23 section

sed -n '25,40p' docs/PROGRESS.md
# Output: 2025-12-23 entries

sed -n '1,20p' CHANGELOG.md
