git status --short
# Output: AGENTS.md and docs/DOCS_AND_LOGGING_SYSTEM.md modified; untracked reports/* files listed

git diff --stat
# Output: AGENTS.md and docs/DOCS_AND_LOGGING_SYSTEM.md changes

git diff AGENTS.md
# Output: policy doc rewrite diff

git diff docs/DOCS_AND_LOGGING_SYSTEM.md
# Output: logging system rewrite diff

date -u +%Y%m%d_%H%M%SZ
# Output: 20251223_062433Z

git stash push -m "temp: local docs changes"
