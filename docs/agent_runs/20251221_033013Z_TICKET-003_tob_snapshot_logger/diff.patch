+++        if not isinstance(entry, Mapping):
+++            continue
+++        side = str(entry.get("side") or "").lower()
+++        if side == "bid":
+++            bids.append(dict(entry))
+++        elif side == "ask":
+++            asks.append(dict(entry))
+++    if not bids and not asks:
+++        return None
