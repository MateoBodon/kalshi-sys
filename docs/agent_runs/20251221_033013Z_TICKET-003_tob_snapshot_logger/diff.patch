+            if parsed.tzinfo is None:
+                parsed = parsed.replace(tzinfo=_ET_ZONE)
+            window_ts_et = parsed.isoformat()
+            window_ts_utc = parsed.astimezone(UTC).isoformat()
+        except ValueError:
