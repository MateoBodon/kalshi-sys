+import polars as pl
+from pathlib import Path
+readme = Path('reports/fillcalib/README.md').read_text(encoding='utf-8')
+cols = [line.strip()[2:].strip() for line in readme.splitlines() if line.strip().startswith('- ') and 'RUN_ID' not in line]
+frame = pl.read_parquet('data/proc/fillcalib/20251221_033013Z_TICKET-003_tob_snapshot_logger.parquet')
+print('README cols:', cols)
+print('Parquet cols:', frame.columns)
+PY
