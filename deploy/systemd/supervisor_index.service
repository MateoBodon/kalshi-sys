[Unit]
Description=Kalshi Index Supervisor (paper-only default)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/kalshi-sys
User=kalshi
Group=kalshi
Environment=SUPERVISOR_BROKER=dry
Environment=PYTHONPATH=/opt/kalshi-sys/src
EnvironmentFile=/etc/kalshi/kalshi-supervisor.env
ExecStart=/usr/bin/env python -m kalshi_alpha.exec.supervisor_index --loop --sleep-seconds 20 --series INXU --dry-run --broker ${SUPERVISOR_BROKER}
Restart=always
RestartSec=10
StartLimitIntervalSec=300
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
